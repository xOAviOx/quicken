# Frontend Supabase access (PUBLIC values — safe to expose to the browser).
# Project Settings -> API in the Supabase dashboard. Use the ANON key, not the
# service role key. Reads rely on the read policies in the module 6 migration.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
