# Supabase — backend/batch credentials (NOT for the browser).
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Service role key: bypasses RLS. Keep it server-side only, never ship to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini (Google AI Studio) — free tier. https://aistudio.google.com/apikey
# Used by the module 3 summarize/image-prompt worker.
GEMINI_API_KEY=your-gemini-api-key
